{
  "name": "markdown-editor-kit",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "desktop": "powershell -NoProfile -File ./scripts/start-editor.ps1",
    "dev": "vite",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:native-export": "node tests/native-export.mjs",
    "test:native-outline": "node tests/native-outline-style.mjs",
    "test:protection": "vitest run tests/change-guard.test.ts tests/ui-contract.test.ts tests/outline-style.test.ts tests/ui-density.test.ts --maxWorkers=1",
    "test:visual": "node tests/native-ui-guard.mjs",
    "check:change:begin": "node scripts/change-guard.mjs --begin",
    "check:change": "node scripts/change-guard.mjs",
    "verify:change": "node scripts/verify-change.mjs",
    "test:watch": "vitest",
    "build:windows": "powershell -NoProfile -File ./scripts/build-windows.ps1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "7.22.3",
    "@milkdown/plugin-highlight": "7.22.3",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "codemirror": "^6.0.2",
    "dictionary-en": "^4.0.0",
    "katex": "^0.19.0",
    "nspell": "^2.1.5",
    "prosemirror-highlight": "^0.16.0",
    "prosemirror-search": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
